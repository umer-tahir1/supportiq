# Copy to .env in the project root. PostgreSQL is the deployment database.
DATABASE_URL=postgresql+psycopg://supportiq:CHANGE_ME@localhost:5432/supportiq
# For local development without PostgreSQL: sqlite:///./supportiq.db
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
POSTGRES_PASSWORD=CHANGE_ME
# Docker API host port; change if another application reserves 8000.
API_PORT=8000
